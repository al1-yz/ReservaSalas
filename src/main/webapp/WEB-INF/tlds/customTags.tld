<?xml version="1.0" encoding="UTF-8"?>
<taglib version="2.1" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd">
  <tlib-version>1.0</tlib-version>
  <short-name>customtags</short-name>
  <uri>https://portal.ifpe.edu.br/recife/tags</uri>

  <tag>
      <name>CarregaSalas</name>
      <tag-class>br.edu.ifpe.recife.reservasalas.controllers.jspTags.CarregaSalas</tag-class>
      <body-content>empty</body-content>
  </tag>

  <tag>
      <name>CarregaEquipamentos</name>
      <tag-class>br.edu.ifpe.recife.reservasalas.controllers.jspTags.CarregaEquipamentos</tag-class>
      <body-content>empty</body-content>
  </tag>

  <tag>
      <name>CarregaTiposSala</name>
      <tag-class>br.edu.ifpe.recife.reservasalas.controllers.jspTags.CarregaTiposSala</tag-class>
      <body-content>empty</body-content>
  </tag>
</taglib>
